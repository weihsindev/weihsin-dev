{
  // 純靜態站:只上傳 dist 當靜態資源,不需要 Cloudflare adapter。
  // 這個檔案存在,wrangler 就不會自己去猜設定並執行 `astro add cloudflare`。
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "weihsin-dev",
  "compatibility_date": "2026-09-09",
  // 找不到的路徑回傳 dist/404.html(由 src/pages/404.astro 產生)。
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
