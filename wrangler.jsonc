{
  // 純靜態站:只上傳 dist 當靜態資源,不需要 Cloudflare adapter。
  // 這個檔案存在,wrangler 就不會自己去猜設定並執行 `astro add cloudflare`。
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "weihsin-dev",
  "compatibility_date": "2026-09-09",
  // 找不到的路徑回傳 dist/404.html(由 src/pages/404.astro 產生)。
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // 網域寫在這裡而不是只留在 dashboard:部署時一併確保 custom domain 存在,
  // 換帳號或重建專案時不必回想當初在 UI 點了什麼。
  "routes": [
    { "pattern": "weihsin.dev", "custom_domain": true }
  ]
}
