---
import { resume, duration, ym } from '../lib/resume';
import '../styles/resume.css';

const { basics, summary, stats, about, experience, projects_intro, projects, background_intro, education, skills, languages, links } = resume;

const software = experience.filter((e) => e.track === 'software');
const preSoftware = experience.filter((e) => e.track === 'pre_software');

// id 明確寫出來:'Selected Work' 含空白,不能用 label 推導錨點。
const sections = [
  { num: '01', label: 'About', id: 'about' },
  { num: '02', label: 'Experience', id: 'experience' },
  { num: '03', label: 'Selected Work', id: 'work' },
  { num: '04', label: 'Stack', id: 'stack' },
  { num: '05', label: 'Background', id: 'background' },
  { num: '06', label: 'Education', id: 'education' },
];

const pageTitle = `${basics.name} (${basics.name_zh}) — ${basics.title}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={summary} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={summary} />
    <meta property="og:type" content="profile" />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap"
    />
  </head>

  <body>
    <main class="page">
      <!-- 頁首 -->
      <div class="row topbar">
        <div class="rail">{basics.name}</div>
        <div class="body">
          <nav class="nav">
            {sections.map((s) => <a href={`#${s.id}`}>{s.num} {s.label}</a>)}
            {links.resume_pdf && <a class="nav-cv" href={links.resume_pdf}>CV.PDF</a>}
          </nav>
        </div>
      </div>

      <!-- 定位。左欄刻意留空:編號從 01 About 開始。 -->
      <div class="row hero">
        <div class="rail"></div>
        <div class="body">
          <h1 class="hero-name">{basics.name}</h1>
          <div class="hero-alt">{basics.name_full} · {basics.name_zh}</div>
          <div class="hero-title">{basics.title}</div>
          {basics.stack_line && <div class="hero-stack">{basics.stack_line}</div>}
          <p class="hero-summary">{summary}</p>
          <div class="stats">
            {stats.map((s) => (
              <div>
                <div class="stat-label">{s.label}</div>
                <div class="stat-value">{s.value}</div>
              </div>
            ))}
            {basics.status && (
              <div>
                <div class="stat-label">狀態</div>
                <div class="stat-value is-accent">{basics.status}</div>
              </div>
            )}
          </div>
        </div>
      </div>

      <!-- 01 About -->
      <section class="row" id="about">
        <div class="rail"><div class="rail-num">01</div><div class="rail-label">About</div></div>
        <div class="body about">
          {about.map((p) => <p>{p}</p>)}
        </div>
      </section>

      <!-- 02 Experience。只放在哪待過多久;交付內容在 03 Selected Work。 -->
      <section class="row" id="experience">
        <div class="rail"><div class="rail-num">02</div><div class="rail-label">Experience</div></div>
        <div class="body">
          {software.map((job) => (
            <article>
              <div class="job-head">
                <h2 class="job-title">{job.role} · {job.company}</h2>
                <div class="job-dates">{ym(job.start)} — {ym(job.end)}</div>
              </div>
              <div class="job-meta">
                {[job.industry, job.company_size, job.location, duration(job.start, job.end)]
                  .filter(Boolean)
                  .join(' · ')}
              </div>
              {job.summary && <p class="job-summary">{job.summary}</p>}
            </article>
          ))}
        </div>
      </section>

      <!-- 03 Selected Work。沿用 .highlights 的版型,形狀相同不另立樣式。 -->
      <section class="row" id="work">
        <div class="rail"><div class="rail-num">03</div><div class="rail-label">Selected Work</div></div>
        <div class="body">
          <p class="section-intro">{projects_intro}</p>
          <div class="highlights">
            {projects.map((pj, i) => (
              <div class="highlight">
                <div class="highlight-num">{String(i + 1).padStart(2, '0')}</div>
                <div>
                  <h3 class="highlight-title">{pj.title}</h3>
                  <div class="highlight-detail">{pj.detail}</div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- 04 Stack -->
      <section class="row" id="stack">
        <div class="rail"><div class="rail-num">04</div><div class="rail-label">Stack</div></div>
        <div class="body">
          <dl class="stack">
            {skills.map((g) => (
              <div class="stack-group">
                <dt class="stack-label">{g.group}</dt>
                <dd class="stack-items">{g.items.join(' · ')}</dd>
              </div>
            ))}
          </dl>
          {languages.map((l) => <div class="langs">{l.name} — {l.level}</div>)}
        </div>
      </section>

      <!-- 05 Background -->
      <section class="row" id="background">
        <div class="rail"><div class="rail-num">05</div><div class="rail-label">Background</div></div>
        <div class="body">
          <p class="section-intro">{background_intro}</p>
          {preSoftware.map((job) => (
            <div class="entry">
              <div class="entry-dates">{ym(job.start)}—<br />{ym(job.end)}</div>
              <div>
                <h3 class="entry-title">{job.role} · {job.company}{job.location === '越南' ? '(越南)' : ''}</h3>
                <div class="entry-detail">{job.summary}</div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- 06 Education -->
      <section class="row" id="education">
        <div class="rail"><div class="rail-num">06</div><div class="rail-label">Education</div></div>
        <div class="body">
          {education.map((e) => (
            <div class="entry">
              <div class="entry-dates">{ym(e.start)}—<br />{ym(e.end)}</div>
              <div>
                <h3 class="entry-title">{e.institution} · {e.program}</h3>
                {e.note && <div class="entry-detail">{e.note}</div>}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- 07 Contact -->
      <section class="row contact" id="contact">
        <div class="rail"><div class="rail-num">07</div><div class="rail-label">Contact</div></div>
        <div class="body">
          <div class="contact-links">
            <a href={`mailto:${links.email}`}>{links.email}</a>
            {/* 履歷 PDF 連結已移除:頁首右上的 CV.PDF 已經是同一個檔,重複放沒有意義。 */}
            {/* GitHub 先隱藏。resume.yaml 的 links.github 設回網址就會顯示。
            {links.github && <><span class="sep">/</span><a href={links.github}>GitHub</a></>}
            */}
          </div>
        </div>
      </section>
    </main>
  </body>
</html>
